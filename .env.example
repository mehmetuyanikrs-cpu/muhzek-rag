# Google AI Studio'dan ücretsiz alınabilir: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# `docker compose up -d db` ile yalnız veritabanını ayağa kaldırıp
# ingest/ask/dev komutlarını kendi makinende çalıştırıyorsan localhost kalsın.
# Tüm yığını (`docker compose up`) container içinde çalıştırırsan app servisi
# bunu otomatik olarak db:5432'ye çevirir (docker-compose.yml'de tanımlı).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/muhzek_rag

PORT=3000
